<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- FOSCH stores Supabase session data in WebView local storage.
         Exclude app-private data so sessions and local app records are not backed up. -->
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
