<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp"
    android:background="@drawable/bg_fosch_widget_surface">

    <FrameLayout
        android:id="@+id/widget_scan_button"
        android:layout_width="48dp"
        android:layout_height="50dp"
        android:background="@drawable/bg_fosch_widget_action"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Scan a product barcode">
        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_qs_scan"
            android:contentDescription="@null" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/widget_search_field"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:background="@drawable/bg_fosch_widget_input"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Enter an E-number or additive name">
        <TextView
            android:id="@+id/widget_search_query"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Search additives"
            android:textColor="@color/fosch_widget_text"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_search_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="E-number or additive name"
            android:textColor="@color/fosch_widget_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_search_button"
        android:layout_width="48dp"
        android:layout_height="50dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_fosch_widget_action"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Search FOSCH">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_fosch_widget_search"
            android:contentDescription="@null" />
    </FrameLayout>
</LinearLayout>
